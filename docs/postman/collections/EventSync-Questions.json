{
  "info": {
    "name": "EventSync Questions API",
    "_postman_id": "eventsync-questions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    }
  ],
  "item": [

    {
      "name": "GET Questions (LIVE)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/questions/sessions/1/questions"
      }
    },

    {
      "name": "POST Create Question",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/questions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"What is EventSync?\",\n  \"sessionId\": 1,\n  \"authorName\": \"John\"\n}"
        }
      }
    },

    {
      "name": "POST Anonymous Question",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/questions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Anonymous question\",\n  \"sessionId\": 1\n}"
        }
      }
    },

    {
      "name": "PUT Upvote",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/questions/1/upvote"
      }
    },

    {
      "name": "DELETE Question",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/questions/1"
      }
    }

  ]
}